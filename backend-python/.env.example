# ==============================================================================
# AI-Assisted House Planning & Visualization System — Backend Environment Template
# ==============================================================================
# Copy this file to .env and fill in the values for your deployment environment.
# NEVER commit production keys or credentials to source control.

# Server & Network Configuration
ENVIRONMENT=production
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.com

# Supabase Database & Auth (Cryptographic ES256 / HS256 JWT Verification)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_optional

# AI Generation Engine & Providers
# AI_PRIMARY_PROVIDER options: groq | gemini
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
FLOOR_PLAN_ENGINE=deterministic
DEMO_FALLBACK_ENABLED=false

# LLM Provider API Keys (Fill at least one active provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_optional
